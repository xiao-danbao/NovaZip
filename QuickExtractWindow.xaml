<Window x:Class="NovaZip.QuickExtractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NovaZip 快速解压" Width="456" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True"
        FontFamily="{StaticResource AppFont}" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">

    <Window.Resources>
        <!-- 快速解压窗口的线性进度条：渐变填充 + 流光扫描 -->
        <Style x:Key="QuickProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentGradientH}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <!-- PART_Track 是 ProgressBar 计算指示条长度的基准，缺失时指示条不会随 Value 变化 -->
                        <Grid x:Name="PART_Track" Height="7" ClipToBounds="True">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF4C7DFF" BlurRadius="10" ShadowDepth="0" Opacity="0.6" />
                                </Border.Effect>
                                <Border Width="44" HorizontalAlignment="Left" Opacity="0.28" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#CCFFFFFF" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ShineShift" X="-60" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="ShineShift"
                                                         Storyboard.TargetProperty="X"
                                                         From="-60" To="430" Duration="0:0:1.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 与主窗口一致：圆角交给 DWM 统一裁切，内部不再画第二层圆角边框 -->
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid x:Name="BackdropLayer">
            <Grid Background="{DynamicResource WindowGlow}" />

            <Ellipse Width="260" Height="260" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-120,-140,0,0" IsHitTestVisible="False" Fill="{DynamicResource BlobAGradient}">
                <Ellipse.Effect>
                    <BlurEffect Radius="70" />
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Width="240" Height="240" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-100,-120" IsHitTestVisible="False" Fill="{DynamicResource BlobBGradient}">
                <Ellipse.Effect>
                    <BlurEffect Radius="80" />
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- 高度随内容自适应：不同状态之间不再留出大片空白 -->
        <Grid Margin="20,15,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题：图标 + 模式 + 压缩包名（同一行，节省纵向空间） -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentGradient}">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF4C7DFF" BlurRadius="12" ShadowDepth="0" Opacity="0.6" />
                    </Border.Effect>
                    <Path Data="{StaticResource IconSpark}" Fill="White" Stretch="Uniform"
                          Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="HeaderText" Grid.Column="1" Text="NovaZip · 快速解压"
                           FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />

                <TextBlock x:Name="ArchiveNameText" Grid.Column="2" Text="" FontSize="10.5"
                           Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="8,1,8,0" />

                <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="CancelClose_Click"
                        AutomationProperties.AutomationId="QuickClose" ToolTip="关闭" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextDimBrush}"
                          StrokeThickness="1.4" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- 进度：百分比与状态同排，文件与速度同排 -->
            <StackPanel x:Name="BusyPanel" Grid.Row="1" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusTitle" Text="正在解压…" FontSize="13.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock x:Name="BarPercentText" Grid.Column="1" Text="0%" FontSize="17"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"
                               Margin="12,-3,0,-3" VerticalAlignment="Center" />
                </Grid>

                <ProgressBar x:Name="Bar" Style="{StaticResource QuickProgressBar}" Value="0" Margin="0,9,0,0" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FileText" Text="正在准备…" FontSize="10.5"
                               Foreground="{DynamicResource TextDimBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatsText" Grid.Column="1" Text="" FontSize="10"
                               Foreground="{DynamicResource TextFaintBrush}" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- 完成 / 失败：图标与文字横排，压缩高度 -->
            <Grid x:Name="DonePanel" Grid.Row="1" Visibility="Collapsed" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="DoneBadge" Width="46" Height="46" CornerRadius="15"
                        Background="{DynamicResource SuccessSoftBgBrush}" BorderBrush="{DynamicResource SuccessSoftBorderBrush}"
                        BorderThickness="1" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="DoneScale" ScaleX="0.7" ScaleY="0.7" />
                    </Border.RenderTransform>
                    <Path x:Name="DoneIcon" Data="{StaticResource IconCheck}" Stroke="{DynamicResource SuccessBrush}"
                          StrokeThickness="2" Width="20" Height="20" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DoneTitle" Text="解压完成" FontSize="14.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="DoneDesc" Text="" FontSize="10.5"
                               Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- 密码 -->
            <StackPanel x:Name="PasswordPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconLock}" Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.4"
                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="该压缩包已加密，请输入密码" FontSize="12" FontWeight="SemiBold"
                               Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <PasswordBox x:Name="PasswordInput" Height="34" Margin="0,9,0,0"
                             Style="{StaticResource ModernPasswordBox}" />
                <TextBlock x:Name="PasswordError" Text="" FontSize="10.5"
                           Foreground="{DynamicResource DangerBrush}" Margin="2,5,0,0" Visibility="Collapsed" />
            </StackPanel>

            <!-- 按钮 -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <StackPanel x:Name="BusyButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="取消" Padding="15,7" FontSize="12"
                            Click="Cancel_Click" AutomationProperties.AutomationId="QuickCancel" />
                </StackPanel>

                <StackPanel x:Name="DoneButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="Collapsed">
                    <Button x:Name="OpenFolderButton" Style="{StaticResource GhostButton}" Padding="15,7" FontSize="12"
                            Click="OpenFolder_Click" AutomationProperties.AutomationId="QuickOpen">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource TextDimBrush}"
                                  Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="OpenFolderText" Text="打开文件夹" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Content="完成" Padding="20,8" FontSize="12"
                            Margin="10,0,0,0" Click="CancelClose_Click" AutomationProperties.AutomationId="QuickDone" />
                </StackPanel>

                <StackPanel x:Name="PasswordButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="Collapsed">
                    <Button Style="{StaticResource GhostButton}" Content="取消" Padding="15,7" FontSize="12"
                            Click="CancelClose_Click" />
                    <Button Style="{StaticResource PrimaryButton}" Content="解压" Padding="20,8" FontSize="12"
                            Margin="10,0,0,0" Click="PasswordOk_Click" AutomationProperties.AutomationId="QuickPasswordOk" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
