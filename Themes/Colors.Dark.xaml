<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Dark palette ============ -->
    <Color x:Key="ColorBg">#FF060910</Color>
    <Color x:Key="ColorBgSoft">#FF0A0F1B</Color>
    <Color x:Key="ColorPanel">#FF0E1524</Color>
    <Color x:Key="ColorPanelRaised">#FF131B2C</Color>
    <Color x:Key="ColorStroke">#FF1F2A3D</Color>
    <Color x:Key="ColorStrokeSoft">#FF161F2F</Color>
    <Color x:Key="ColorStrokeStrong">#FF2B3A55</Color>
    <Color x:Key="ColorText">#FFEDF2FB</Color>
    <Color x:Key="ColorTextDim">#FFA3B2CB</Color>
    <Color x:Key="ColorTextFaint">#FF7A89A3</Color>
    <Color x:Key="ColorAccent">#FF38BDF8</Color>
    <Color x:Key="ColorAccent2">#FF8B5CF6</Color>
    <Color x:Key="ColorAccent3">#FF22D3EE</Color>
    <Color x:Key="ColorSuccess">#FF34D399</Color>
    <Color x:Key="ColorDanger">#FFF87171</Color>
    <Color x:Key="ColorWarn">#FFFBBF24</Color>
    <Color x:Key="ColorSuccessText">#FF6EE7B7</Color>
    <Color x:Key="ColorAccentText">#FFD8EEFF</Color>

    <!-- ============ Surfaces ============ -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="BgSoftBrush" Color="{StaticResource ColorBgSoft}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource ColorPanel}" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource ColorPanelRaised}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource ColorStroke}" />
    <SolidColorBrush x:Key="StrokeSoftBrush" Color="{StaticResource ColorStrokeSoft}" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource ColorStrokeStrong}" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FF1A2436" />

    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C9121C2E" Offset="0" />
        <GradientStop Color="#A80B1220" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B8131D2F" Offset="0" />
        <GradientStop Color="#990A111E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#24FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF0C1322" />
    <SolidColorBrush x:Key="SegmentTrackBrush" Color="#FF0B1220" />
    <SolidColorBrush x:Key="DialogBrush" Color="#FF0E1524" />
    <SolidColorBrush x:Key="ToastBrush" Color="#F50D1424" />
    <SolidColorBrush x:Key="ProgressCardBrush" Color="#F20D1424" />
    <SolidColorBrush x:Key="TooltipBrush" Color="#F2121A2A" />

    <!-- ============ Text ============ -->
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource ColorTextDim}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource ColorTextFaint}" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource ColorSuccessText}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource ColorAccentText}" />

    <!-- ============ Accents ============ -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource ColorAccent2}" />
    <SolidColorBrush x:Key="Accent3Brush" Color="{StaticResource ColorAccent3}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource ColorWarn}" />

    <SolidColorBrush x:Key="AccentTintBrush" Color="#1238BDF8" />
    <SolidColorBrush x:Key="AccentBorderSoftBrush" Color="#4D38BDF8" />
    <SolidColorBrush x:Key="AccentBorderFaintBrush" Color="#334C7DFF" />
    <SolidColorBrush x:Key="SuccessSoftBgBrush" Color="#1A34D399" />
    <SolidColorBrush x:Key="SuccessSoftBorderBrush" Color="#3334D399" />
    <SolidColorBrush x:Key="WarnSoftBgBrush" Color="#1AFBBF24" />
    <SolidColorBrush x:Key="WarnSoftBorderBrush" Color="#33FBBF24" />
    <SolidColorBrush x:Key="PillBgBrush" Color="#1A38BDF8" />
    <SolidColorBrush x:Key="PillBorderBrush" Color="#3338BDF8" />
    <SolidColorBrush x:Key="PillTextBrush" Color="#FF8AD9FA" />

    <!-- ============ Controls ============ -->
    <SolidColorBrush x:Key="ControlBrush" Color="#FF101827" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF16213A" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#FF2C3E5C" />
    <SolidColorBrush x:Key="HoverBrush" Color="#FF172034" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#FF121B2C" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#332F6FB8" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="NavHoverForegroundBrush" Color="#FFC9D6EC" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#FF14203A" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FF9AA1A8" />
    <SolidColorBrush x:Key="TrackBrush" Color="#FF1B2537" />
    <SolidColorBrush x:Key="DropZoneBrush" Color="#800B1220" />
    <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#FF22314C" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />
    <SolidColorBrush x:Key="ScrimStrongBrush" Color="#99000000" />

    <!-- ============ Gradients ============ -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF38BDF8" Offset="0" />
        <GradientStop Color="#FF6366F1" Offset="0.55" />
        <GradientStop Color="#FFA855F7" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientH" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF38BDF8" Offset="0" />
        <GradientStop Color="#FF8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientSoft" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3338BDF8" Offset="0" />
        <GradientStop Color="#338B5CF6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HighlightGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#42FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.7" />
    </LinearGradientBrush>

    <!-- 半透明底色：让窗口后的桌面透过 DWM 亚克力模糊层，同时保证文字对比度 -->
    <LinearGradientBrush x:Key="WindowGlow" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C4060910" Offset="0" />
        <GradientStop Color="#BC080D18" Offset="0.45" />
        <GradientStop Color="#B80A1020" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7A0E1728" Offset="0" />
        <GradientStop Color="#5A0A111E" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="ThemeRippleBrush">
        <GradientStop Color="#6638BDF8" Offset="0" />
        <GradientStop Color="#338B5CF6" Offset="0.45" />
        <GradientStop Color="#004C7DFF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BlobAGradient">
        <GradientStop Color="#5538BDF8" Offset="0" />
        <GradientStop Color="#0038BDF8" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BlobBGradient">
        <GradientStop Color="#4C8B5CF6" Offset="0" />
        <GradientStop Color="#008B5CF6" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="DropZoneGlow">
        <GradientStop Color="#2E38BDF8" Offset="0" />
        <GradientStop Color="#0038BDF8" Offset="1" />
    </RadialGradientBrush>

    <!-- ============ Effects ============ -->
    <DropShadowEffect x:Key="SoftShadow" Color="#FF000000" BlurRadius="30" ShadowDepth="6" Opacity="0.45" />
    <DropShadowEffect x:Key="CardShadow" Color="#FF000000" BlurRadius="26" ShadowDepth="8" Opacity="0.34" />
    <DropShadowEffect x:Key="AccentGlow" Color="#FF4C7DFF" BlurRadius="26" ShadowDepth="0" Opacity="0.85" />
</ResourceDictionary>
