<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>NovaZip</AssemblyName>
    <RootNamespace>NovaZip</RootNamespace>
    <Product>NovaZip 现代解压</Product>
    <Description>基于 7-Zip 26.06 内核的现代化压缩/解压工具</Description>
    <Version>1.4.7</Version>
    <AssemblyVersion>1.4.7.0</AssemblyVersion>
    <FileVersion>1.4.7.0</FileVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="runtime\7z.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="runtime\7z.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="runtime\7-Zip-License.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 内核同时内嵌进 EXE：应用内更新只替换 exe 时仍能自恢复，无需依赖 runtime 目录 -->
  <ItemGroup>
    <EmbeddedResource Include="runtime\7z.dll">
      <LogicalName>NovaZip.runtime.7z.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="runtime\7z.exe">
      <LogicalName>NovaZip.runtime.7z.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="runtime\7-Zip-License.txt">
      <LogicalName>NovaZip.runtime.7-Zip-License.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
