<Window x:Class="NovaZip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:NovaZip.Controls"
        Title="NovaZip" Width="1260" Height="820" MinWidth="1040" MinHeight="680"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False" Background="Transparent" UseLayoutRounding="True"
        FontFamily="{StaticResource AppFont}" Foreground="{DynamicResource TextBrush}"
        AllowDrop="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 显式指定窗口级滚动条样式：细条圆角悬浮滑块 -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- ===== Ambient background ===== -->
        <Grid x:Name="BackdropLayer">
            <Grid Background="{DynamicResource WindowGlow}" />

            <Ellipse x:Name="BlobA" Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-220,-260,0,0" IsHitTestVisible="False" Fill="{DynamicResource BlobAGradient}">
                <Ellipse.Effect>
                    <BlurEffect Radius="90" />
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BlobATransform" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="BlobB" Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-260,-320" IsHitTestVisible="False" Fill="{DynamicResource BlobBGradient}">
                <Ellipse.Effect>
                    <BlurEffect Radius="110" />
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BlobBTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- ===== Shell ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentGradient}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF4C7DFF" BlurRadius="14" ShadowDepth="0" Opacity="0.7" />
                        </Border.Effect>
                        <Path Data="{StaticResource IconSpark}" Fill="White" Stretch="Uniform" Width="12" Height="12"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="NovaZip" FontFamily="{StaticResource DisplayFont}" FontSize="14.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,10,0" />
                    <Border Style="{StaticResource Pill}" Padding="7,2">
                        <TextBlock Text="7-Zip 26.06 内核" Style="{StaticResource PillText}" FontSize="10" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="SettingsButton" Style="{StaticResource TitleBarButton}" Click="Settings_Click"
                            AutomationProperties.AutomationId="BtnSettings" ToolTip="设置">
                        <Path Data="{StaticResource IconSettings}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="ThemeButton" Style="{StaticResource TitleBarButton}" Click="Theme_Click"
                            AutomationProperties.AutomationId="BtnTheme" ToolTip="切换浅色 / 深色主题">
                        <Grid Width="15" Height="15" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="ThemeIconRotate" />
                            </Grid.RenderTransform>
                            <Path x:Name="ThemeSunIcon" Data="{StaticResource IconSun}" Visibility="Collapsed"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" Stretch="Uniform" />
                            <Path x:Name="ThemeMoonIcon" Data="{StaticResource IconMoon}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" ToolTip="最小化" Click="Minimize_Click">
                        <Path Data="{StaticResource IconMinus}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" ToolTip="最大化" Click="Maximize_Click">
                        <Path Data="{StaticResource IconMaximize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" Width="11" Height="11" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" ToolTip="关闭" Click="Close_Click">
                        <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Width="11" Height="11" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="258" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== Sidebar ===== -->
                <Border Grid.Column="0" Margin="16,4,6,16" CornerRadius="20"
                        Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource StrokeSoftBrush}"
                        BorderThickness="1">
                    <Grid Margin="4,2,4,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="6,10,6,14">
                        <TextBlock Text="工作台" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}"
                                   Margin="16,0,0,10" />
                        <RadioButton x:Name="NavExtract" Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="True"
                                     Checked="Nav_Checked" Tag="extract">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconExtract}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="解压" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavCreate" Style="{StaticResource NavButton}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="create">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCreate}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="压缩" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="history">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHistory}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="历史记录" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <Button x:Name="QueueButton" Style="{StaticResource NavActionButton}" Click="Queue_Click"
                                ToolTip="查看后台解压任务">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconBatch}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="任务队列" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <Border x:Name="QueueBadge" Grid.Column="2" Visibility="Collapsed" CornerRadius="9"
                                        Background="{DynamicResource AccentGradient}" Padding="7,1"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock x:Name="QueueCountText" Text="0" FontSize="10" FontWeight="SemiBold"
                                               Foreground="White" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Engine card -->
                    <Border Grid.Row="1" VerticalAlignment="Bottom" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,4,8"
                            Background="{DynamicResource GlassBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.4"
                                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="内核运行状态" FontSize="11.5" Foreground="{DynamicResource TextDimBrush}"
                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="EngineNameText" Text="7z.dll · 26.06" FontSize="13.5" FontWeight="SemiBold"
                                       Margin="0,8,0,2" />
                            <TextBlock x:Name="EngineFormatsText" Text="正在加载内核…" FontSize="11.5"
                                       Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" />
                            <Border Background="{DynamicResource SuccessSoftBgBrush}" BorderBrush="{DynamicResource SuccessSoftBorderBrush}" BorderThickness="1" CornerRadius="7"
                                    Padding="8,3" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#FF34D399" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="已通过自检" FontSize="10" Foreground="{DynamicResource SuccessTextBrush}" Margin="5,0,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="2" Text="NovaZip 1.4.7 · 现代化归档工具" FontSize="10.5"
                               Foreground="{DynamicResource TextFaintBrush}" Margin="10,0,0,8" />
                    </Grid>
                </Border>

                <!-- ===== Content ===== -->
                <Grid Grid.Column="1" Margin="10,2,18,16">

                    <!-- ============ EXTRACT PAGE ============ -->
                    <Grid x:Name="PageExtract">
                        <!-- empty state -->
                        <Grid x:Name="EmptyState" Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="DropZone" Grid.Row="0" Margin="14,18,14,10" CornerRadius="24"
                                    Background="{DynamicResource DropZoneBrush}" BorderBrush="{DynamicResource DropZoneBorderBrush}" BorderThickness="1.6"
                                    AllowDrop="True" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                                    Drop="DropZone_Drop" Cursor="Hand" MouseLeftButtonUp="DropZone_Click">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="DropScale" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF38BDF8" BlurRadius="40" ShadowDepth="0" Opacity="0" />
                                </Border.Effect>

                                <Grid>
                                    <!-- corner glow -->
                                    <Ellipse Width="420" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Opacity="0.5" IsHitTestVisible="False" Fill="{DynamicResource DropZoneGlow}">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="60" />
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="86" Height="86" CornerRadius="26" Background="{DynamicResource AccentGradientSoft}"
                                                BorderBrush="{DynamicResource AccentBorderSoftBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#FF4C7DFF" BlurRadius="30" ShadowDepth="0" Opacity="0.5" />
                                            </Border.Effect>
                                            <Grid>
                                                <Path Data="{StaticResource IconArchive}" Fill="{DynamicResource AccentBrush}"
                                                      Stretch="Uniform" Width="38" Height="38" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                                <Ellipse Width="86" Height="86" Stroke="{DynamicResource AccentBorderFaintBrush}" StrokeThickness="1"
                                                         StrokeDashArray="3 5">
                                                    <Ellipse.RenderTransform>
                                                        <RotateTransform x:Name="DashRotate" CenterX="43" CenterY="43" />
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="拖入压缩包，即刻解压" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   Margin="0,22,0,0" />
                                        <TextBlock Text="支持 7Z · ZIP · RAR · TAR · GZ · XZ · ISO · WIM 等 30+ 种格式"
                                                   FontSize="12.5" Foreground="{DynamicResource TextDimBrush}"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                                        <TextBlock Text="也可直接双击任意压缩包，或在下方选择文件"
                                                   FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                                            <Button x:Name="OpenArchiveButton" Style="{StaticResource PrimaryButton}"
                                                    Click="OpenArchive_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconFolder}" Fill="White" Stretch="Uniform"
                                                          Width="14" Height="14" VerticalAlignment="Center" />
                                                    <TextBlock Text="选择压缩包" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Click="NavigateCreate_Click" Margin="12,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconCreate}" Stroke="{DynamicResource TextBrush}"
                                                          StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="新建压缩包" Margin="7,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Click="BatchExtract_Click" Margin="12,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconBatch}" Stroke="{DynamicResource TextBrush}"
                                                          StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="批量解压" Margin="7,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Border Style="{StaticResource Pill}" Margin="5,0"><TextBlock Text="7Z" Style="{StaticResource PillText}" /></Border>
                                <Border Style="{StaticResource Pill}" Margin="5,0"><TextBlock Text="ZIP" Style="{StaticResource PillText}" /></Border>
                                <Border Style="{StaticResource Pill}" Margin="5,0"><TextBlock Text="RAR" Style="{StaticResource PillText}" /></Border>
                                <Border Style="{StaticResource Pill}" Margin="5,0"><TextBlock Text="TAR" Style="{StaticResource PillText}" /></Border>
                                <Border Style="{StaticResource Pill}" Margin="5,0"><TextBlock Text="GZ" Style="{StaticResource PillText}" /></Border>
                                <Border Style="{StaticResource Pill}" Margin="5,0"><TextBlock Text="XZ" Style="{StaticResource PillText}" /></Border>
                                <Border Style="{StaticResource Pill}" Margin="5,0"><TextBlock Text="ISO" Style="{StaticResource PillText}" /></Border>
                                <Border Style="{StaticResource Pill}" Margin="5,0"><TextBlock Text="WIM" Style="{StaticResource PillText}" /></Border>
                            </StackPanel>
                        </Grid>

                        <!-- archive state -->
                        <Grid x:Name="ArchiveState" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,17" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource AccentGradient}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF4C7DFF" BlurRadius="22" ShadowDepth="0" Opacity="0.55" />
                                        </Border.Effect>
                                        <Path Data="{StaticResource IconArchive}" Fill="White" Stretch="Uniform"
                                              Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ArchiveNameText" Text="" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border x:Name="FormatPill" Style="{StaticResource Pill}" Margin="0,0,8,0">
                                                <TextBlock x:Name="FormatPillText" Text="7Z" Style="{StaticResource PillText}" />
                                            </Border>
                                            <TextBlock x:Name="ArchiveMetaText" Text="" FontSize="12"
                                                       Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                                            <Border x:Name="EncryptedPill" Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                    Background="{DynamicResource WarnSoftBgBrush}" BorderBrush="{DynamicResource WarnSoftBorderBrush}" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconLock}" Stroke="{DynamicResource WarnBrush}"
                                                          StrokeThickness="1.3" Width="9" Height="9" Stretch="Uniform"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="已加密" FontSize="10" Foreground="{DynamicResource WarnBrush}"
                                                               Margin="4,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnTest" Style="{StaticResource GhostButton}" Click="TestArchive_Click" ToolTip="校验压缩包完整性">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource SuccessBrush}"
                                                      StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="校验" Margin="7,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnExtractTo" Style="{StaticResource GhostButton}" Click="ExtractTo_Click" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource TextDimBrush}"
                                                      Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" />
                                                <TextBlock Text="解压到…" Margin="7,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnExtractAll" Style="{StaticResource PrimaryButton}" Click="ExtractAll_Click" Margin="10,0,0,0"
                                                Padding="20,10">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconExtract}" Stroke="White" StrokeThickness="1.6"
                                                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="全部解压" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- toolbar -->
                            <Grid Grid.Row="1" Margin="2,16,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="268" Height="38" CornerRadius="11" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextFaintBrush}"
                                              StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"
                                              Margin="12,0,8,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                                 FontSize="12.5" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                                        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="搜索文件或文件夹…" FontSize="12.5"
                                                   Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                        <Button x:Name="ClearSearchButton" Grid.Column="2" Style="{StaticResource IconButton}"
                                                Width="28" Height="28" Margin="0,0,4,0" Visibility="Collapsed"
                                                Click="ClearSearch_Click" ToolTip="清空">
                                            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextDimBrush}"
                                                  StrokeThickness="1.4" Width="9" Height="9" Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock x:Name="FilterCountText" Text="" FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Style="{StaticResource IconButton}" Click="BatchExtract_Click"
                                            ToolTip="批量解压多个压缩包">
                                        <Path Data="{StaticResource IconBatch}" Stroke="{DynamicResource TextDimBrush}"
                                              StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Padding="14,8" Click="OpenArchive_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconArchive}" Fill="{DynamicResource TextDimBrush}"
                                                  Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" />
                                            <TextBlock Text="打开其它压缩包" Margin="7,0,0,0" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="CloseArchive_Click" ToolTip="关闭当前压缩包">
                                        <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextDimBrush}"
                                              StrokeThickness="1.4" Width="11" Height="11" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- filter chips + sort + entry editing -->
                            <Grid Grid.Row="2" Margin="2,0,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource SegmentTrackBrush}" CornerRadius="12" Padding="4"
                                        Margin="0,0,14,0">
                                    <UniformGrid Rows="1" Columns="7">
                                        <RadioButton x:Name="ChipAll" Style="{StaticResource ChipButton}" GroupName="Chip"
                                                     Content="全部" IsChecked="True" Tag="all" Checked="FilterChip_Checked" />
                                        <RadioButton Style="{StaticResource ChipButton}" GroupName="Chip" Content="文件"
                                                     Tag="file" Checked="FilterChip_Checked" />
                                        <RadioButton Style="{StaticResource ChipButton}" GroupName="Chip" Content="文件夹"
                                                     Tag="folder" Checked="FilterChip_Checked" />
                                        <RadioButton Style="{StaticResource ChipButton}" GroupName="Chip" Content="图片"
                                                     Tag="image" Checked="FilterChip_Checked" />
                                        <RadioButton Style="{StaticResource ChipButton}" GroupName="Chip" Content="音视频"
                                                     Tag="media" Checked="FilterChip_Checked" />
                                        <RadioButton Style="{StaticResource ChipButton}" GroupName="Chip" Content="文档"
                                                     Tag="doc" Checked="FilterChip_Checked" />
                                        <RadioButton Style="{StaticResource ChipButton}" GroupName="Chip" Content="代码"
                                                     Tag="code" Checked="FilterChip_Checked" />
                                    </UniformGrid>
                                </Border>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="SortButton" Style="{StaticResource GhostButton}" Padding="11,6"
                                            Click="Sort_Click" ToolTip="切换排序方式">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSort}" Stroke="{DynamicResource TextDimBrush}"
                                                  StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform"
                                                  VerticalAlignment="Center" />
                                            <TextBlock x:Name="SortText" Text="名称" FontSize="11.5" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Border Width="1" Background="{DynamicResource DividerBrush}" Margin="10,6,8,6" />
                                    <Button x:Name="BtnPreview" Style="{StaticResource IconButton}" Click="PreviewSelected_Click"
                                            ToolTip="预览所选文件（也可双击条目）">
                                        <Path Data="{StaticResource IconEye}" Stroke="{DynamicResource TextDimBrush}"
                                              StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                    <Button x:Name="BtnEditAdd" Style="{StaticResource IconButton}" Click="AddEntry_Click"
                                            ToolTip="向压缩包添加文件">
                                        <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource TextDimBrush}"
                                              StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
                                    </Button>
                                    <Button x:Name="BtnEditDelete" Style="{StaticResource IconButton}" Click="DeleteEntry_Click"
                                            ToolTip="删除所选条目">
                                        <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource TextDimBrush}"
                                              StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" />
                                    </Button>
                                    <Button x:Name="BtnEditRename" Style="{StaticResource IconButton}" Click="RenameEntry_Click"
                                            ToolTip="重命名所选条目">
                                        <Path Data="{StaticResource IconPencil}" Stroke="{DynamicResource TextDimBrush}"
                                              StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- column headers -->
                            <Grid Grid.Row="3" Margin="12,4,20,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="152" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="名称" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}" />
                                <TextBlock Grid.Column="1" Text="原始大小" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFaintBrush}" />
                                <TextBlock Grid.Column="2" Text="压缩后" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFaintBrush}" />
                                <TextBlock Grid.Column="3" Text="修改时间" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFaintBrush}" />
                            </Grid>

                            <ListBox x:Name="EntryList" Grid.Row="4" Style="{StaticResource EntryListBox}"
                                     SelectionMode="Extended" IsSynchronizedWithCurrentItem="False"
                                     AllowDrop="True" DragOver="EntryList_DragOver" Drop="EntryList_Drop"
                                     MouseDoubleClick="EntryList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="46" Margin="12,0,14,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="152" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="30" Height="30" CornerRadius="9" Background="{Binding IconBackground}">
                                                    <Path Data="{Binding Icon}" Fill="{Binding IconBrush}" Stretch="Uniform"
                                                          Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                                    <TextBlock Text="{Binding Directory}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextFaintBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                               Visibility="{Binding HasDirectory, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <Border Style="{StaticResource Pill}" Background="{DynamicResource WarnSoftBgBrush}" BorderBrush="{DynamicResource WarnSoftBorderBrush}"
                                                        Padding="6,2" Margin="8,0,0,0"
                                                        Visibility="{Binding IsEncrypted, Converter={StaticResource BoolToVis}}">
                                                    <Path Data="{StaticResource IconLock}" Stroke="{DynamicResource WarnBrush}"
                                                          StrokeThickness="1.3" Width="8" Height="8" Stretch="Uniform" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource CellText}" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PackedText}" Style="{StaticResource CellText}" />
                                                <Border Height="2.5" CornerRadius="1.5" Background="{DynamicResource TrackBrush}" Margin="0,4,26,0"
                                                        Visibility="{Binding ShowRatioBar, Converter={StaticResource BoolToVis}}">
                                                    <Border HorizontalAlignment="Left" CornerRadius="1.5"
                                                            Background="{DynamicResource AccentGradientH}" Width="{Binding RatioWidth}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding DateText}" Style="{StaticResource CellText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid x:Name="EntryEmptyHint" Grid.Row="4" Visibility="Collapsed" IsHitTestVisible="False">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource AccentTintBrush}"
                                            HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconArchive}" Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.4" Width="22" Height="22" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="EntryEmptyTitle" Text="没有匹配的条目" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    <TextBlock x:Name="EntryEmptyDesc" Text="换个筛选条件或搜索关键词试试" FontSize="11.5"
                                               Foreground="{DynamicResource TextFaintBrush}"
                                               HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="5" Margin="0,8,0,0" Padding="4,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StatusSummaryText" Text="" FontSize="11.5"
                                               Foreground="{DynamicResource TextFaintBrush}" />
                                    <TextBlock Text=" · " FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}" />
                                    <TextBlock x:Name="StatusPathText" Text="" FontSize="11.5"
                                               Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis"
                                               MaxWidth="560" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ============ CREATE PAGE ============ -->
                    <Grid x:Name="PageCreate" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="2,18,0,16">
                            <TextBlock Text="创建压缩包" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold" />
                            <TextBlock Text="把文件或文件夹拖进来，选择格式与压缩等级，一键生成。" FontSize="12.5"
                                       Foreground="{DynamicResource TextDimBrush}" Margin="0,6,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="356" />
                            </Grid.ColumnDefinitions>

                            <!-- left: drop + sources -->
                            <Grid Grid.Column="0" Margin="0,0,16,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border x:Name="CreateDropZone" Grid.Row="0" Height="132" CornerRadius="18"
                                        Background="{DynamicResource DropZoneBrush}" BorderBrush="{DynamicResource DropZoneBorderBrush}" BorderThickness="1.6"
                                        AllowDrop="True" DragEnter="CreateDropZone_DragEnter" DragLeave="CreateDropZone_DragLeave"
                                        Drop="CreateDropZone_Drop" Cursor="Hand" MouseLeftButtonUp="AddFiles_Click">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="CreateDropScale" ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                    <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                    <Grid Margin="20,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource AccentGradientSoft}"
                                                VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCreate}" Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="2" Width="18" Height="18" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="拖入文件或文件夹" FontSize="14.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="或点击此处从资源管理器选择" FontSize="11.5" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnAddFiles" Style="{StaticResource GhostButton}" Padding="12,7"
                                                    Click="AddFiles_Click">
                                                <TextBlock Text="选择文件" FontSize="12" />
                                            </Button>
                                            <Button x:Name="BtnAddFolder" Style="{StaticResource GhostButton}" Padding="12,7" Margin="8,0,0,0"
                                                    Click="AddFolder_Click">
                                                <TextBlock Text="选择文件夹" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Margin="18,14,14,10">
                                            <TextBlock Text="待压缩内容" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="SourceSummaryText" Text="0 个项目" FontSize="11.5"
                                                           Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"
                                                           Margin="0,0,10,0" />
                                                <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                                        Click="ClearSources_Click" ToolTip="清空列表">
                                                    <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource TextDimBrush}"
                                                          StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <ListBox x:Name="SourceList" Grid.Row="1" Style="{StaticResource EntryListBox}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="44" Margin="14,0,10,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="28" Height="28" CornerRadius="8" Background="{Binding IconBackground}"
                                                                VerticalAlignment="Center">
                                                            <Path Data="{Binding Icon}" Fill="{Binding IconBrush}" Stretch="Uniform"
                                                                  Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding FullPath}" FontSize="10"
                                                                       Foreground="{DynamicResource TextFaintBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource CellText}" />
                                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="26" Height="26"
                                                                Tag="{Binding}" Click="RemoveSource_Click" ToolTip="移除">
                                                            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextFaintBrush}"
                                                                  StrokeThickness="1.4" Width="8" Height="8" Stretch="Uniform" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Grid x:Name="SourceEmptyHint" Grid.Row="1" Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12">
                                                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                                                    <Ellipse Width="96" Height="96" Fill="{DynamicResource AccentTintBrush}" />
                                                    <Ellipse Width="64" Height="64" Fill="{DynamicResource AccentGradientSoft}" />
                                                    <Border Width="44" Height="44" CornerRadius="14"
                                                            Background="{DynamicResource AccentGradient}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconCreate}" Stroke="White" StrokeThickness="1.8"
                                                              Width="18" Height="18" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="还没有待压缩的内容" FontSize="13.5" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                                                <TextBlock Text="拖入文件或文件夹，也可以从资源管理器中选择" FontSize="11.5"
                                                           Foreground="{DynamicResource TextFaintBrush}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                                    <Button Style="{StaticResource GhostButton}" Padding="14,7" Click="AddFiles_Click">
                                                        <TextBlock Text="选择文件" FontSize="12" />
                                                    </Button>
                                                    <Button Style="{StaticResource GhostButton}" Padding="14,7" Margin="8,0,0,0"
                                                            Click="AddFolder_Click">
                                                        <TextBlock Text="选择文件夹" FontSize="12" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Row="2" x:Name="SourceFootText" Text="" FontSize="11"
                                                   Foreground="{DynamicResource TextFaintBrush}" Margin="18,10,18,14" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- right: settings -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,18">
                                <StackPanel>
                                    <TextBlock Text="输出设置" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextDimBrush}" />
                                    <TextBlock Text="压缩格式" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,16,0,8" />
                                    <Border Background="{DynamicResource SegmentTrackBrush}" CornerRadius="12" Padding="4">
                                        <UniformGrid Rows="1" Columns="3">
                                            <RadioButton x:Name="Format7z" Style="{StaticResource SegmentButton}" GroupName="Fmt"
                                                         Content="7Z" IsChecked="True" FontSize="12.5" Padding="10,7" />
                                            <RadioButton x:Name="FormatZip" Style="{StaticResource SegmentButton}" GroupName="Fmt"
                                                         Content="ZIP" FontSize="12.5" Padding="10,7" />
                                            <RadioButton x:Name="FormatTar" Style="{StaticResource SegmentButton}" GroupName="Fmt"
                                                         Content="TAR" FontSize="12.5" Padding="10,7" />
                                        </UniformGrid>
                                    </Border>

                                    <TextBlock Text="压缩等级" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,18,0,8" />
                                    <Border Background="{DynamicResource SegmentTrackBrush}" CornerRadius="12" Padding="4">
                                        <UniformGrid Rows="1" Columns="3">
                                            <RadioButton x:Name="Level1" Style="{StaticResource SegmentButton}" GroupName="Lvl"
                                                         Content="快速" IsChecked="True" Padding="10,7" FontSize="12.5" />
                                            <RadioButton x:Name="Level5" Style="{StaticResource SegmentButton}" GroupName="Lvl"
                                                         Content="标准" Padding="10,7" FontSize="12.5" />
                                            <RadioButton x:Name="Level9" Style="{StaticResource SegmentButton}" GroupName="Lvl"
                                                         Content="极限" Padding="10,7" FontSize="12.5" />
                                        </UniformGrid>
                                    </Border>

                                    <TextBlock Text="压缩后大小上限（可选）" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,18,0,8" />
                                    <Grid>
                                        <TextBox x:Name="TargetSizeBox" Style="{StaticResource ModernTextBox}" Height="38"
                                                 FontSize="12.5" TextChanged="TargetSize_TextChanged" />
                                        <TextBlock x:Name="TargetSizeHint" Text="例如 50" FontSize="11.5"
                                                   Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"
                                                   Margin="13,0,34,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="MB" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   IsHitTestVisible="False" />
                                    </Grid>

                                    <TextBlock Text="分卷大小（可选）" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,18,0,8" />
                                    <Grid>
                                        <TextBox x:Name="VolumeSizeBox" Style="{StaticResource ModernTextBox}" Height="38"
                                                 FontSize="12.5" TextChanged="VolumeSize_TextChanged" />
                                        <TextBlock x:Name="VolumeSizeHint" Text="每卷大小，例如 100" FontSize="11.5"
                                                   Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"
                                                   Margin="13,0,34,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="MB" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   IsHitTestVisible="False" />
                                    </Grid>

                                    <TextBlock Text="加密密码（可选）" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,18,0,8" />
                                    <PasswordBox x:Name="CreatePasswordBox" Style="{StaticResource ModernPasswordBox}"
                                                 Height="38" />

                                    <TextBlock Text="输出文件" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,18,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OutputPathBox" Style="{StaticResource ModernTextBox}" Height="38"
                                                 FontSize="12" />
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="12,8"
                                                Margin="8,0,0,0" Click="BrowseOutput_Click">
                                            <TextBlock Text="浏览" FontSize="12" />
                                        </Button>
                                    </Grid>

                                    <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="12" Padding="12,10" Margin="0,18,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSpark}" Fill="{DynamicResource AccentBrush}"
                                                  Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" />
                                            <TextBlock x:Name="EstimateText" Text="添加文件后可查看压缩预估" FontSize="10.5"
                                                       Foreground="{DynamicResource TextDimBrush}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <TextBlock x:Name="CreateStatusText" Text="" FontSize="11.5"
                                       Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                            <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                    Padding="30,12" Click="CreateArchive_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSpark}" Fill="White" Stretch="Uniform"
                                          Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="开始压缩" Margin="8,0,0,0" FontSize="14" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- ============ HISTORY PAGE ============ -->
                    <Grid x:Name="PageHistory" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="2,18,0,18">
                            <TextBlock Text="历史记录" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold" />
                            <TextBlock Text="本次运行中的解压与压缩操作都会记录在这里。" FontSize="12.5"
                                       Foreground="{DynamicResource TextDimBrush}" Margin="0,6,0,0" />
                        </StackPanel>

                        <ListBox x:Name="HistoryList" Grid.Row="1" Style="{StaticResource EntryListBox}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="14" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                            BorderThickness="1" Padding="16,14" Margin="0,0,6,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="38" Height="38" CornerRadius="11" Background="{Binding IconBackground}"
                                                    VerticalAlignment="Center">
                                                <Path Data="{Binding Icon}" Fill="{Binding IconBrush}" Stretch="Uniform"
                                                      Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border CornerRadius="7" Padding="9,4" Background="{Binding StatusBackground}"
                                                        BorderBrush="{Binding StatusBorder}" BorderThickness="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                               Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                                                           HorizontalAlignment="Right" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid x:Name="HistoryEmpty" Grid.Row="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentTintBrush}" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconHistory}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                                          Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="暂无操作记录" FontSize="13" Foreground="{DynamicResource TextDimBrush}"
                                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="2" x:Name="HistorySummaryText" Text="" FontSize="11.5"
                                   Foreground="{DynamicResource TextFaintBrush}" Margin="2,10,0,0" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Theme transition ripple ===== -->
        <Grid x:Name="ThemeRippleLayer" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="ThemeRipple" Width="980" Height="980" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-470,-410,0" Fill="{DynamicResource ThemeRippleBrush}" Opacity="0"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="ThemeRippleScale" ScaleX="0.08" ScaleY="0.08" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- ===== Progress overlay ===== -->
        <Grid x:Name="ProgressOverlay" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}">
            <Grid x:Name="ProgressCard" Width="560" Height="118" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                  Margin="0,0,0,32">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ProgressSlide" Y="40" />
                </Grid.RenderTransform>
                <Border CornerRadius="20" Background="{DynamicResource ProgressCardBrush}" BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                        Padding="18,16" Effect="{DynamicResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <controls:ProgressRing x:Name="ProgressRing" Width="72" Height="72" Value="0"
                                               TrackBrush="{DynamicResource TrackBrush}"
                                               VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ProgressTitle" Text="正在解压…" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="ProgressFileText" Text="" FontSize="11.5" Foreground="{DynamicResource TextDimBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock x:Name="ProgressBytesText" Text="" FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" />
                                <TextBlock Text="  ·  " FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" />
                                <TextBlock x:Name="ProgressSpeedText" Text="" FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="PauseResumeButton" Grid.Column="2" Style="{StaticResource GhostButton}" Padding="14,8"
                                Click="PauseOperation_Click" VerticalAlignment="Center" Margin="0,0,8,0"
                                Visibility="Collapsed" ToolTip="暂停解压，进度已保存，可随时继续">
                            <TextBlock x:Name="PauseResumeText" Text="暂停" FontSize="12" />
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="14,8" Click="CancelOperation_Click"
                                VerticalAlignment="Center">
                            <TextBlock Text="取消" FontSize="12" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Toasts ===== -->
        <ItemsControl x:Name="ToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,22,22"
                      IsHitTestVisible="False" />

        <!-- ===== 启动恢复提示 ===== -->
        <Border x:Name="RestoreBanner" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="22,0,0,22" CornerRadius="16" Padding="18,14"
                Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
                BorderThickness="1" Effect="{DynamicResource CardShadow}"
                MouseLeftButtonDown="Panel_MouseDown">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconBatch}" Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock x:Name="RestoreTitleText" Text="检测到未完成的解压任务" FontSize="13" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="RestoreDetailText" Text="上次中断的任务可以继续" FontSize="10.5"
                           Foreground="{DynamicResource TextFaintBrush}" Margin="0,5,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="忽略" Style="{StaticResource GhostButton}" Padding="14,6" FontSize="12"
                            Click="RestoreDismiss_Click" />
                    <Button Content="继续解压" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="12"
                            Margin="8,0,0,0" Click="RestoreContinue_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Password modal ===== -->
        <Grid x:Name="PasswordOverlay" Visibility="Collapsed" Background="{DynamicResource ScrimStrongBrush}">
            <Border Width="420" CornerRadius="20" Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                    Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{DynamicResource CardShadow}">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PasswordScale" ScaleX="0.92" ScaleY="0.92" />
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource WarnSoftBgBrush}">
                            <Path Data="{StaticResource IconLock}" Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.5"
                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="需要密码" FontSize="15.5" FontWeight="SemiBold" />
                            <TextBlock Text="该压缩包已加密，请输入解压密码。" FontSize="11.5"
                                       Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource ModernPasswordBox}" Height="40" Margin="0,20,0,0" />
                    <TextBlock x:Name="PasswordErrorText" Text="" Foreground="{DynamicResource DangerBrush}" FontSize="11"
                               Margin="2,8,0,0" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="取消" Padding="18,9" Click="PasswordCancel_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Content="解锁并继续" Padding="20,10" Margin="10,0,0,0"
                                Click="PasswordOk_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Settings ===== -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}"
              MouseLeftButtonDown="SettingsScrim_Click">
            <Border x:Name="SettingsPanel" Width="392" VerticalAlignment="Top" HorizontalAlignment="Right"
                    Margin="0,58,18,0" CornerRadius="20" Background="{DynamicResource DialogBrush}"
                    BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                    Effect="{DynamicResource CardShadow}" MouseLeftButtonDown="Panel_MouseDown">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SettingsSlide" X="26" />
                </Border.RenderTransform>
                <ScrollViewer Style="{StaticResource OverlayScrollViewer}"
                              Margin="0,10,3,10" MaxHeight="700">
                <StackPanel Margin="22,8,16,6">
                    <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="外观、集成与解压行为" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                               Margin="0,4,0,0" />

                    <TextBlock Text="主题模式" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,18,0,8" />
                    <Border Background="{DynamicResource SegmentTrackBrush}" CornerRadius="12" Padding="4">
                        <UniformGrid Rows="1" Columns="3">
                            <RadioButton x:Name="ThemeAuto" Style="{StaticResource SegmentButton}" GroupName="ThemeMode"
                                         Content="跟随系统" Tag="auto" Padding="8,7" FontSize="12" Checked="ThemeMode_Checked" />
                            <RadioButton x:Name="ThemeDark" Style="{StaticResource SegmentButton}" GroupName="ThemeMode"
                                         Content="深色" Tag="dark" Padding="8,7" FontSize="12" Checked="ThemeMode_Checked" />
                            <RadioButton x:Name="ThemeLight" Style="{StaticResource SegmentButton}" GroupName="ThemeMode"
                                         Content="浅色" Tag="light" Padding="8,7" FontSize="12" Checked="ThemeMode_Checked" />
                        </UniformGrid>
                    </Border>
                    <TextBlock x:Name="ThemeHintText" Text="已跟随 Windows 亮暗模式" FontSize="10.5"
                               Foreground="{DynamicResource TextFaintBrush}" Margin="2,7,0,0" />

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,0,4" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="资源管理器右键菜单" FontSize="13" />
                            <TextBlock Text="在文件与文件夹右键菜单显示“用 NovaZip 解压 / 压缩”" FontSize="10.5"
                                       Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            <TextBlock Text="Windows 11 新式菜单只显示系统项，请在「显示更多选项」(Shift+F10) 中查看"
                                       FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="ContextMenuToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                  VerticalAlignment="Center" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Windows 11 经典右键菜单" FontSize="13" />
                            <TextBlock Text="让 NovaZip 直接出现在一级菜单；切换后会自动重启资源管理器" FontSize="10.5"
                                       Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="ClassicMenuToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                  VerticalAlignment="Center" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="窗口背景透明度" FontSize="13" />
                            <TextBlock Text="调整桌面透视背景的浓淡，0% 时只剩亚克力模糊，越透明越通透" FontSize="10.5"
                                       Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="OpacityValueText" Grid.Column="1" Text="100%" FontSize="12"
                                   Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Top" />
                        <Slider x:Name="OpacitySlider" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                                Value="100" Style="{StaticResource SlimSlider}" Margin="0,12,0,0"
                                ValueChanged="OpacitySlider_ValueChanged" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="智能解压" FontSize="13" />
                            <TextBlock Text="自动剥离压缩包内单层重复目录，避免双层同名文件夹" FontSize="10.5"
                                       Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="SmartExtractToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                  VerticalAlignment="Center" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="排除隐藏与临时文件" FontSize="13" />
                            <TextBlock Text="压缩时跳过隐藏、系统、Thumbs.db 与 ~$ 临时文件" FontSize="10.5"
                                       Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="ExcludeJunkToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                  VerticalAlignment="Center" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="修复中文乱码文件名" FontSize="13" />
                            <TextBlock Text="解压后自动还原旧式 ZIP 中按 GBK 存储的乱码文件名" FontSize="10.5"
                                       Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="FixLegacyNamesToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                  VerticalAlignment="Center" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="加入系统「打开方式」" FontSize="13" />
                            <TextBlock Text="让 NovaZip 出现在压缩包的打开方式列表，默认程序可在系统设置中选择" FontSize="10.5"
                                       Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="FileAssocToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                  VerticalAlignment="Center" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,0,4" />

                    <TextBlock Text="软件更新" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,14,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="自动检查更新" FontSize="13" />
                            <TextBlock Text="启动时最多每 24 小时静默检查一次，发现新版本才提示" FontSize="10.5"
                                       Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="AutoUpdateToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                  VerticalAlignment="Center" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="UpdateStatusText" Text="当前版本 1.4.7" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock x:Name="UpdateHintText" Text="从 GitHub Releases 下载，校验后自动重启安装"
                                       FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button x:Name="CheckUpdateButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                Content="检查更新" Padding="14,7" FontSize="12" VerticalAlignment="Center"
                                Click="CheckUpdate_Click" />
                    </Grid>

                    <ProgressBar x:Name="UpdateProgress" Height="3" Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed" Margin="0,10,4,0" BorderThickness="0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource SegmentTrackBrush}" />

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,0,12" />
                    <TextBlock x:Name="AboutText" Text="NovaZip 1.4.7 · 7-Zip 26.06 内核（内置）" FontSize="10.5"
                               Foreground="{DynamicResource TextFaintBrush}" />
                    <TextBlock Text="所有设置即时生效，无需重启" FontSize="10.5"
                               Foreground="{DynamicResource TextFaintBrush}" Margin="0,3,0,0" />

                    <TextBlock Text="更新日志（1.4.7，含 1.4.5 / 1.4.6 能力）" FontSize="11"
                               Foreground="{DynamicResource TextBrush}" FontWeight="Medium" Margin="0,12,0,4" />
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                               LineHeight="17"
                               Text="· 内核内置：7z.dll / 7z.exe 打包进 EXE，程序目录缺 runtime 时自动解出到本机缓存，只有一个 exe 也能解压&#x0a;· 更新修复：应用内更新只替换 exe 后不再提示「找不到 7-Zip 内核」&#x0a;· 冷启动优化：右键菜单自检、断点记录扫描改为后台执行，首帧显示更快&#x0a;· 大包打开优化：万级条目列表分片填充，打开超大压缩包时窗口不再长时间无响应&#x0a;· 分段解压加固：磁盘只剩几 MB 时按最小批次继续推进，暂停提示带具体剩余空间&#x0a;· 断点续传：解压中断自动保存进度，再次解压自动从断点继续，超大文件按字节级续写（实验性）" />

                    <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="10"
                            Background="{DynamicResource WarnSoftBgBrush}"
                            BorderBrush="{DynamicResource WarnSoftBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="实验性功能提示" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarnBrush}" />
                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                                       LineHeight="17" Margin="0,4,0,0"
                                       Text="断点续传、智能分段解压、暂停/继续与启动恢复属于本次新增的实验性功能，在不同压缩格式、磁盘与系统环境下不一定稳定生效；如遇异常，请重新完整解压，并可在任务面板底部「清理断点」后重试。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Task queue ===== -->
        <Border x:Name="QueuePanel" Width="382" HorizontalAlignment="Right" Margin="0,58,18,18"
                CornerRadius="20" Background="{DynamicResource DialogBrush}"
                BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                Effect="{DynamicResource CardShadow}" Visibility="Collapsed"
                MouseLeftButtonDown="Panel_MouseDown">
            <Border.RenderTransform>
                <TranslateTransform x:Name="QueueSlide" X="400" />
            </Border.RenderTransform>
            <Grid Margin="20,18,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconBatch}" Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="任务队列" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="QueueSummaryText" Text="暂无任务" FontSize="10.5"
                                   Foreground="{DynamicResource TextFaintBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="QueueClose_Click" ToolTip="收起任务队列">
                        <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextDimBrush}"
                              StrokeThickness="1.4" Width="11" Height="11" Stretch="Uniform" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <ListBox x:Name="QueueList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="13" Background="{DynamicResource GlassBrush}"
                                        BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1"
                                        Padding="13,11" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,5,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Opacity" Value="0.35" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 From="1" To="0.22" Duration="0:0:0.8"
                                                                                                 AutoReverse="True" RepeatBehavior="Forever" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 To="0.35" Duration="0:0:0.2" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StateLabel}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <ProgressBar Style="{StaticResource SlimProgressBar}" Maximum="100"
                                                     Value="{Binding Percent}" Margin="0,9,0,0" />

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Detail}" FontSize="10"
                                                       Foreground="{DynamicResource TextFaintBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Margin="0,0,8,0" ToolTip="{Binding Detail}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding PercentText}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextDimBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <Button Content="打开目录" Tag="{Binding}"
                                                        Style="{StaticResource QueueMiniButton}"
                                                        Click="QueueOpenFolder_Click"
                                                        Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}" />
                                                <Button Content="继续" Tag="{Binding}"
                                                        Style="{StaticResource QueueMiniButton}"
                                                        Click="QueueItemResume_Click"
                                                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" />
                                                <Button Content="取消" Tag="{Binding}"
                                                        Style="{StaticResource QueueMiniButton}"
                                                        Click="QueueItemCancel_Click"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="QueueEmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="46" Height="46" CornerRadius="15" Background="{DynamicResource AccentGradientSoft}"
                                HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconBatch}" Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.4" Width="19" Height="19" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="队列空闲" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="批量解压或一次拖入多个压缩包时" FontSize="10.5"
                                   Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="任务会自动排队并在后台依次完成" FontSize="10.5"
                                   Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="QueuePauseButton" Content="暂停" Style="{StaticResource GhostButton}"
                            Padding="10,7" FontSize="12" Click="QueuePause_Click" Margin="0,0,5,0" />
                    <Button Grid.Column="1" Content="取消全部" Style="{StaticResource GhostButton}" Padding="10,7"
                            FontSize="12" Click="QueueCancelAll_Click" Margin="4,0,4,0" />
                    <Button Grid.Column="2" Content="清除已完成" Style="{StaticResource GhostButton}"
                            Padding="10,7" FontSize="12" Click="QueueClear_Click" Margin="4,0,4,0" />
                    <Button Grid.Column="3" Content="清理断点" Style="{StaticResource GhostButton}"
                            Padding="10,7" FontSize="12" Click="QueueCleanup_Click" Margin="5,0,0,0"
                            ToolTip="删除全部断点进度记录，已中断的任务将无法继续" />
                </Grid>
            </Grid>
        </Border>

        <!-- ===== Entry preview ===== -->
        <Grid x:Name="PreviewOverlay" Visibility="Collapsed" Background="{DynamicResource ScrimStrongBrush}"
              MouseLeftButtonDown="PreviewScrim_Click">
            <Border x:Name="PreviewCard" Width="860" Height="620" CornerRadius="22"
                    Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
                    BorderThickness="1" Effect="{DynamicResource CardShadow}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="Panel_MouseDown">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PreviewScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>
                <Grid Margin="22,18,22,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentGradientSoft}">
                            <Path Data="{StaticResource IconEye}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                                  Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewTitleText" Text="" FontSize="14.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PreviewPathText" Text="" FontSize="10.5"
                                       Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="ClosePreview_Click" ToolTip="关闭预览">
                            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextDimBrush}"
                                  StrokeThickness="1.4" Width="11" Height="11" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <TextBox x:Name="PreviewTextBox" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True"
                                     IsUndoEnabled="False" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextBrush}" CaretBrush="Transparent"
                                     FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12.5"
                                     Padding="16" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                            <Image x:Name="PreviewImage" Visibility="Collapsed" Stretch="Uniform" Margin="16" />
                            <StackPanel x:Name="PreviewFallback" Visibility="Collapsed" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentTintBrush}"
                                        HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconFile}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                                          Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="该类型暂不支持内置预览" FontSize="13" Foreground="{DynamicResource TextDimBrush}"
                                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                                <Button Style="{StaticResource GhostButton}" Click="OpenPreviewExternal_Click"
                                        HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconOpenExternal}" Stroke="{DynamicResource TextBrush}"
                                              StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="用系统默认程序打开" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock x:Name="PreviewInfoText" Text="" FontSize="10.5"
                                   Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="PreviewEditButton" Style="{StaticResource GhostButton}" Content="编辑内容"
                                    Padding="16,8" FontSize="12" Click="PreviewEdit_Click"
                                    Visibility="Collapsed" Margin="0,0,10,0" />
                            <Button Style="{StaticResource GhostButton}" Content="用默认程序打开" Padding="16,8"
                                    FontSize="12" Click="OpenPreviewExternal_Click" />
                            <Button Style="{StaticResource PrimaryButton}" Content="关闭" Padding="20,9" Margin="10,0,0,0"
                                    Click="ClosePreview_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Rename prompt ===== -->
        <Grid x:Name="RenameOverlay" Visibility="Collapsed" Background="{DynamicResource ScrimStrongBrush}">
            <Border Width="440" CornerRadius="20" Background="{DynamicResource DialogBrush}"
                    BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1" Padding="24,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{DynamicResource CardShadow}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="RenameScale" ScaleX="0.94" ScaleY="0.94" />
                </Border.RenderTransform>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentTintBrush}">
                            <Path Data="{StaticResource IconPencil}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="重命名条目" FontSize="15.5" FontWeight="SemiBold" />
                            <TextBlock Text="输入新的名称，可保留原有扩展名。" FontSize="11.5"
                                       Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBox x:Name="RenameInput" Style="{StaticResource ModernTextBox}" Height="40" Margin="0,20,0,0" />
                    <TextBlock x:Name="RenameErrorText" Text="" Foreground="{DynamicResource DangerBrush}" FontSize="11"
                               Margin="2,8,0,0" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="取消" Padding="18,9" Click="RenameCancel_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Content="确定" Padding="22,10" Margin="10,0,0,0"
                                Click="RenameOk_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
